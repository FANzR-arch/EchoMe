# Public URLs only. Never put keys, passwords or private prompts in VITE_* variables.
# Local independent sites: visitor 5174, administrator 5175.
VITE_CHAT_SITE_URL=http://127.0.0.1:5174
# Optional override; defaults to http://127.0.0.1:5175 plus "embedOrigins" in your owner config.
# VITE_EMBED_ALLOWED_ORIGINS=http://127.0.0.1:5175,https://your-site.example

# Your identity and knowledge. Keep real ones in git-ignored copies:
#   cp owner.config.json owner.config.local.json   and   cp -r knowledge knowledge.local
PAI_OWNER_CONFIG=owner.config.json
PAI_KNOWLEDGE_DIR=knowledge
# Optional: folder of your website source for `npm run knowledge:sync`.
# PAI_SITE_DIR=../my-website

# Server only. Copy to .env.local and fill locally, then restart Vite.
# Confirm provider, base URL and model before switching to real.
PAI_MODE=mock
PAI_API_BASE_URL=https://api.deepseek.com
PAI_MODEL=deepseek-flash
PAI_API_KEY=
# Signs assistant replies so visitors cannot forge chat history. Any long random string.
# If empty, one is derived from PAI_API_KEY (signatures then rotate with the key).
PAI_HISTORY_SECRET=

# Optional server-only Codex CLI settings. Never use VITE_ prefixes.
# Leave model empty to use the existing top-level Codex model setting.
PAI_CODEX_MODEL=
PAI_CODEX_PROXY=
# Nonstandard npm Codex JS launcher location, if needed.
# PAI_CODEX_JS=C:/path/to/@openai/codex/bin/codex.js

# Server-only cloud storage. Use the project service_role key, never anon/publishable.
PAI_SUPABASE_URL=
PAI_SUPABASE_SECRET_KEY=
# Exact HTTPS chat origin, no trailing slash (Vercel only).
PAI_PUBLIC_ORIGIN=

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:cloud",
  "outputDirectory": "dist/chat",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{deploy/knowledge-release.json,owner.config.json,knowledge/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api?route=chat"
    },
    {
      "source": "/api/config",
      "destination": "/api?route=config"
    },
    {
      "source": "/api/mcp",
      "destination": "/api?route=mcp"
    },
    {
      "source": "/api/handoff",
      "destination": "/api?route=handoff"
    },
    {
      "source": "/api/replies",
      "destination": "/api?route=replies"
    },
    {
      "source": "/chat",
      "destination": "/index.html"
    },
    {
      "source": "/install",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "regions": [
    "hnd1"
  ]
}
